#--------------------------
# annotate
#==========================
Idents(sc.data)<-sc.data$sub.cluster
levels(sc.data)
new.ident <- c(
"0"= "Goblet",            # 0
"1"= "Contamination",     # 1
"2"="Ciliated",          # 2
"3"="Ciliated",          # 3
"4"="Suprabasal",        # 4
"5"="Club",              # 5
"6_1"="Basal",             # 6_1
"7"="Goblet",            # 7
"8"="Deuterosomal",      # 8
"9"="Mature_Ciliated",   # 9
"10"="Goblet",            # 10
"11"="Ciliated",          # 11
"12"="Ciliated",          # 12
"6_0"="Basal",             # 6_0
"6_2"="Basal",             # 6_2
"6_4"="Activated_Basal",   # 6_4
"6_3"="Cycling_Basal"      # 6_3
)
sc.data <- RenameIdents(sc.data, new.ident)
sc.data <- AddMetaData(
sc.data,
metadata = Idents(sc.data),
col.name = "cell_types"
)
p<- DimPlot(sc.data,
reduction = "umap",
group.by = "cell_types",
label = F)
p1<- DimPlot(sc.data,
reduction = "umap",
group.by = "sub.cluster",
label = T)
ggsave("analysis/umap_final.png", p,dpi=300,
width = 6, height = 5)
ggsave("analysis/umap_deurat_clust.png", p1,dpi=300,
width = 6, height = 5)
dittoSeq::dittoBarPlot(sc.data, var="cell_types",
group.by = "group")

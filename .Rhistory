graph.name = "RNA_snn"
)
sc.data <- FindSubCluster(
sc.data,
cluster = "4",
resolution = 0.1,
graph.name = "RNA_snn"
)
sc.data <- FindSubCluster(
sc.data,
cluster = "9",
resolution = 0.3,
graph.name = "RNA_snn"
)
sc.data <- FindSubCluster(
sc.data,
cluster = "9_0",
resolution = 0.3,
graph.name = "RNA_snn"
)
sc.data <- FindSubCluster(
sc.data,
cluster = "9_0",
resolution = 0.5,
graph.name = "RNA_snn"
)
#=========================================
# Return to FindAllMarkers
